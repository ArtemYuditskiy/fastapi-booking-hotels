MODE=DEV
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hotel_booking
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hotel_booking_test

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_CACHE_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_BEAT_INTERVAL_SECONDS=60
CELERY_TASK_ALWAYS_EAGER=false
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=10
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_CLAIM_TIMEOUT_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=bookings@example.test
SMTP_TIMEOUT_SECONDS=10.0
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
CATALOG_CACHE_TTL_SECONDS=300
